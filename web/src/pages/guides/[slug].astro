---
// /guides/<slug>: one answer-first guide. Short answer on top (quotable by
// answer engines), the article, steps (HowTo), questions (FAQPage), live
// searches and collections to try, related guides and the sources it cites.
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/collections/Breadcrumbs.astro";
import CollectionCard from "@/components/collections/CollectionCard.astro";
import { allGuides, guideCollections, guidePath, readingMinutes, relatedGuides, type Guide } from "@/lib/guides";
import { article, breadcrumbs, faqPage, howTo } from "@/lib/schema";
import { dateFmt } from "@/lib/collections";

export async function getStaticPaths() {
  return (await allGuides()).map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

interface Props {
  guide: Guide;
}
const { guide: g } = Astro.props;
const d = g.data;
const path = guidePath(g.id);
const { Content, headings } = await render(g);
const toc = headings.filter((h) => h.depth === 2);
const collections = await guideCollections(g);
const related = await relatedGuides(g);
const minutes = readingMinutes(g);
const trail = [{ name: "Home", path: "/" }, { name: "Guides", path: "/guides" }, { name: d.title, path }];
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  markdown={`${path}.md`}
  ogType="article"
  section={d.section}
  schema={[
    article({ title: d.title, description: d.description, path, answer: d.answer, section: d.section, published: d.published, updated: d.updated, cites: d.cites, words: minutes * 220 }),
    ...(d.kind === "howto" && d.steps ? [howTo({ title: d.title, description: d.description, path, steps: d.steps })] : []),
    ...(d.faq.length ? [faqPage(d.faq)] : []),
    breadcrumbs(trail),
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs trail={trail} />
    <div class="mt-6 grid gap-12 xl:grid-cols-[1fr_15rem]">
      <article class="min-w-0 max-w-3xl">
        <header>
          <p class="text-sm font-medium text-primary"><a href={`/guides#${d.section.toLowerCase().replace(/\s+/g, "-")}`} class="hover:underline">{d.section}</a></p>
          <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{d.title}</h1>
          <p class="mt-3 text-sm text-muted-foreground">
            Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{dateFmt.format(d.updated)}</time> · {minutes} min read
          </p>
        </header>

        <section class="mt-8 rounded-xl border border-primary/30 bg-primary/5 p-5" aria-labelledby="answer">
          <h2 id="answer" class="text-sm font-semibold uppercase tracking-wide text-primary">Short answer</h2>
          <p class="mt-2 text-pretty leading-relaxed">{d.answer}</p>
        </section>

        <div class="prose-docs mt-10">
          <Content />
        </div>

        {d.steps?.length ? (
          <section class="mt-12" aria-labelledby="steps">
            <h2 id="steps" class="text-2xl font-semibold tracking-tight">Step by step</h2>
            <ol class="mt-6 space-y-4">
              {d.steps.map((s, i) => (
                <li id={`step-${i + 1}`} class="flex gap-4 rounded-xl border p-4">
                  <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-primary/15 text-sm font-semibold text-primary" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3 class="font-medium">{s.name}</h3>
                    <p class="mt-1 text-sm text-muted-foreground">{s.text}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ) : null}

        {d.faq.length > 0 && (
          <section class="mt-12" aria-labelledby="faq">
            <h2 id="faq" class="text-2xl font-semibold tracking-tight">Questions</h2>
            <dl class="mt-6 divide-y rounded-xl border">
              {d.faq.map((f) => (
                <div class="p-5">
                  <dt class="font-medium">{f.q}</dt>
                  <dd class="mt-2 text-sm text-muted-foreground">{f.a}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        {d.searches.length > 0 && (
          <section class="mt-12" aria-labelledby="try">
            <h2 id="try" class="text-2xl font-semibold tracking-tight">Try it</h2>
            <p class="mt-2 text-sm text-muted-foreground">Live searches across every source, with a licence verdict on each result.</p>
            <ul class="mt-4 flex flex-wrap gap-2 text-sm">
              {d.searches.map((s) => <li><a href={s.href} class="inline-flex rounded-full border px-3 py-1 text-muted-foreground transition hover:border-primary/40 hover:text-foreground">{s.label}</a></li>)}
            </ul>
          </section>
        )}

        {d.cites.length > 0 && (
          <section class="mt-12" aria-labelledby="sources">
            <h2 id="sources" class="text-xl font-semibold tracking-tight">Sources</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted-foreground">
              {d.cites.map((c) => <li><a href={c.url} rel="noopener" class="text-primary underline underline-offset-2">{c.name}</a></li>)}
            </ul>
          </section>
        )}
        <p class="mt-10 text-xs text-muted-foreground">
          Practical information, not legal advice. AI agent? This guide is also available as <a class="text-primary underline underline-offset-2" href={`${path}.md`}>Markdown</a>.
        </p>
      </article>

      <aside class="hidden xl:block">
        <nav class="sticky top-24 space-y-8 text-sm" aria-label="In this guide">
          {toc.length > 1 && (
            <div>
              <p class="mb-2 font-medium">In this guide</p>
              <ul class="space-y-1.5 text-muted-foreground">
                <li><a class="hover:text-foreground" href="#answer">Short answer</a></li>
                {toc.map((h) => <li><a class="hover:text-foreground" href={`#${h.slug}`}>{h.text}</a></li>)}
                {d.steps?.length ? <li><a class="hover:text-foreground" href="#steps">Step by step</a></li> : null}
                {d.faq.length > 0 && <li><a class="hover:text-foreground" href="#faq">Questions</a></li>}
              </ul>
            </div>
          )}
        </nav>
      </aside>
    </div>

    {collections.length > 0 && (
      <section class="mt-16" aria-labelledby="collections">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h2 id="collections" class="text-2xl font-semibold tracking-tight">Free samples to start with</h2>
          <a href="/samples" class="text-sm text-primary hover:underline">All collections →</a>
        </div>
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {collections.slice(0, 6).map((c) => <CollectionCard collection={c} />)}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-16" aria-labelledby="related">
        <h2 id="related" class="text-2xl font-semibold tracking-tight">Related guides</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {related.map((r) => (
            <li class="rounded-xl border p-5 transition hover:border-primary/40">
              <h3 class="font-medium"><a href={guidePath(r.id)} class="hover:text-primary">{r.data.title}</a></h3>
              <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{r.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
<script>
  import "@/scripts/preview-player";
</script>
