---
import DocsLayout from "@/layouts/DocsLayout.astro";
import { sourcesList } from "@/lib/schema";
import { PROVIDERS, SOURCE_COUNT } from "@/lib/site";
import { VERDICT_LABELS, categoryLabel, verdictTone, type Verdict } from "@/lib/vocab";

const access = { api: "API", static: "Catalogue", scrape: "Site search", link: "Deep link" } as const;
const pricing = { free: "Free", freemium: "Free + paid", paid: "Paid" } as const;
const toneClass = { green: "text-success", amber: "text-warning", red: "text-destructive" } as const;
const headings = [{ depth: 2, slug: "all-sources", text: "All sources" }, { depth: 2, slug: "how-sources-are-searched", text: "How sources are searched" }, { depth: 2, slug: "licences", text: "Licences" }];
---

<DocsLayout
  title="Sources & licences"
  crumb="Sources & licences"
  description={`The ${SOURCE_COUNT} sample sites searched (Freesound, Wikimedia Commons, Openverse, ccMixter, SampleRadar…) with sounds, pricing, licences and downloads.`}
  headings={headings}
  schema={[sourcesList()]}
>
  <h1>Sources &amp; licences</h1>
  <p>
    One search covers {SOURCE_COUNT} sites. Each result keeps its source's licence and gets a verdict on commercial use, so you can tell at a glance what you may release and whether you have to credit the author.
  </p>

  <h2 id="all-sources">All sources</h2>
  <div class="not-prose overflow-x-auto rounded-xl border">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-left text-xs uppercase tracking-wide text-muted-foreground">
        <tr>
          <th class="px-4 py-3 font-medium">Source</th>
          <th class="px-4 py-3 font-medium">Best for</th>
          <th class="px-4 py-3 font-medium">Search</th>
          <th class="px-4 py-3 font-medium">Pricing</th>
          <th class="px-4 py-3 font-medium">Licence</th>
          <th class="px-4 py-3 font-medium">Direct download</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {PROVIDERS.map((p) => (
          <tr id={p.id} class="scroll-mt-24 align-top target:bg-primary/10">
            <td class="px-4 py-3 font-medium">
              <a href={`/sources/${p.id}`} class="text-primary hover:underline">{p.name}</a>
              <div class="mt-1 font-mono text-[11px] font-normal text-muted-foreground">{p.id} · <a href={p.homepage} class="hover:text-foreground" rel="noopener">site ↗</a></div>
            </td>
            <td class="px-4 py-3 text-muted-foreground">
              {p.description}
              {p.categories.length > 0 && <div class="mt-1 text-xs">{p.categories.map(categoryLabel).join(", ")}</div>}
            </td>
            <td class="px-4 py-3 whitespace-nowrap">{access[p.access]}</td>
            <td class="px-4 py-3 whitespace-nowrap">{pricing[p.pricing]}</td>
            <td class="px-4 py-3">
              {p.license ?? "Per sample"}
              {p.licenseVerdict && <div class:list={["mt-1 text-xs", toneClass[verdictTone(p.licenseVerdict)]]}>{VERDICT_LABELS[p.licenseVerdict as Verdict] ?? p.licenseVerdict}</div>}
            </td>
            <td class="px-4 py-3">{p.supportsDownload ? "Yes" : "Source page"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="how-sources-are-searched">How sources are searched</h2>
  <ul>
    <li><strong>API</strong>: the source's official or public JSON API. Richest metadata (licence per sound, author, duration, sometimes BPM and key), often with direct files.</li>
    <li><strong>Catalogue</strong>: a fixed collection published as manifest files or pack lists (drum machine manifests, orchestral libraries, free packs). It is fetched once, cached, and filtered on the server.</li>
    <li><strong>Site search</strong>: the source's public pages are read like a browser would, politely and with caching.</li>
    <li><strong>Deep link</strong>: the site does not allow automated search (Splice, Looperman, Loopcloud and others). The search response includes a link that runs the same query on that site, so you still know where else to look.</li>
  </ul>
  <p>Every source has its own timeout. A slow or failing site shows up in the per-source report and never fails the search. Categories, BPM and key that a source doesn't provide are filled in from titles, tags and, on request, by analysing the preview.</p>

  <h2 id="licences">Licences</h2>
  <p>
    Each result's <code>license</code> carries an SPDX-style <code>id</code>, a <code>name</code>, whether credit is required, who asserted it (<code>source</code>, <code>site</code> or <code>uploader</code>) and a <code>verdict</code> on commercial use. <strong>CC0</strong> and public-domain sounds need no credit. <strong>Royalty free</strong> site licences allow use in your music but never redistribution of the samples themselves. <strong>CC BY</strong> needs a credit line, <strong>share-alike</strong> and <strong>Sampling+</strong> come with conditions, and <strong>NC</strong> licences rule out commercial releases.
    The full rules, with examples, are in <a href="/docs/licences">Sample licences explained</a>.
  </p>
</DocsLayout>
