---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/collections/Breadcrumbs.astro";
import CollectionCard from "@/components/collections/CollectionCard.astro";
import { allCollections, allHubs, dateFmt, hubPath, latest } from "@/lib/collections";
import { breadcrumbs, collectionPage } from "@/lib/schema";
import { SOURCE_COUNT } from "@/lib/site";

const all = await allCollections();
const hubs = await allHubs();
const updated = latest(all);
const title = "Free sample collections";
const description = `Curated collections of free drum samples, 808s, vocal chops, FX and ambience from ${SOURCE_COUNT} sample sites, with a licence verdict on every sound, refreshed daily.`;
const trail = [{ name: "Home", path: "/" }, { name: "Sample collections", path: "/samples" }];
---

<BaseLayout
  title={title}
  description={description}
  markdown="/samples.md"
  schema={[
    collectionPage({ title, description, path: "/samples", dateModified: updated, links: [...hubs.map((h) => ({ name: h.title, path: hubPath(h) })), ...all.map((c) => ({ name: c.topic.data.title, path: c.path }))] }),
    breadcrumbs(trail),
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs trail={trail} />
    <header class="mt-6 max-w-3xl">
      <p class="text-sm font-medium text-primary">Sound Server</p>
      <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-4 text-pretty text-muted-foreground">
        Each collection answers one need, such as a punchy kick, a dark 808, a vocal chop or a riser for the drop, with the best free matches from {SOURCE_COUNT} sample sites side by side. Press play on any card to hear it. Every sound shows its source and whether you may release it commercially, and the lists are refreshed from a live search every day.
      </p>
      {updated && <p class="mt-3 text-sm text-muted-foreground">{all.length} collections, updated <time datetime={updated.toISOString()}>{dateFmt.format(updated)}</time>.</p>}
    </header>

    {hubs.map((hub) => {
      const cs = all.filter((c) => c.hub.id === hub.id);
      return cs.length ? (
        <section class="mt-14" aria-labelledby={`hub-${hub.id}`}>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id={`hub-${hub.id}`} class="text-2xl font-semibold tracking-tight"><a href={hubPath(hub)} class="hover:text-primary">{hub.title}</a></h2>
            <a href={hubPath(hub)} class="text-sm text-primary underline underline-offset-2 hover:decoration-2">All {hub.name.toLowerCase()} →</a>
          </div>
          <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {cs.map((c) => <CollectionCard collection={c} />)}
          </ul>
        </section>
      ) : null;
    })}

    <p class="mt-16 text-sm text-muted-foreground">
      Looking for something else? <a href="/search" class="text-primary underline underline-offset-2 hover:decoration-2">Search all {SOURCE_COUNT} sites</a>, <a href="/kit" class="text-primary underline underline-offset-2 hover:decoration-2">build a drum kit</a>, or see <a href="/docs/sources" class="text-primary underline underline-offset-2 hover:decoration-2">every source and its licence</a>.
    </p>
  </div>
</BaseLayout>
<script>
  import "@/scripts/preview-player";
</script>
