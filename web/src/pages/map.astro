---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SoundMap from "@/components/map/SoundMap";
import { breadcrumbs } from "@/lib/schema";
import { PROVIDERS } from "@/lib/site";

const title = "Sound map";
const description = "Every sound this server has listened to, laid out so that sounds that sound alike sit close together. Click a dot to hear it.";
const names = Object.fromEntries(PROVIDERS.map((p) => [p.id, p.name]));
---

<BaseLayout title={title} description={description} noindex schema={[breadcrumbs([{ name: "Home", path: "/" }, { name: title, path: "/map" }])]}>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <header class="max-w-3xl">
      <p class="text-sm font-medium text-primary">Sound map</p>
      <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">Browse sounds by how they sound</h1>
      <p class="mt-3 text-pretty text-muted-foreground">
        Each dot is a sample. Sounds that sound alike sit close together: kicks near other kicks, risers near sweeps, airy pads away from gritty basses. Colours show the category. Click a dot to hear it, scroll to zoom and drag to move around.
      </p>
    </header>
    <div class="mt-8">
      <SoundMap client:only="react" names={names} />
    </div>
    <noscript>
      <p class="mt-6 text-sm text-muted-foreground">The map needs JavaScript. The points are also available as JSON at <a class="text-primary underline" href="/v1/map">/v1/map</a>.</p>
    </noscript>
    <section class="mt-16 max-w-3xl" aria-labelledby="how">
      <h2 id="how" class="text-xl font-semibold tracking-tight">How the map is made</h2>
      <p class="mt-2 text-sm text-muted-foreground">
        The server listens to each sample's preview with CLAP, an audio model that turns a sound into 512 numbers describing how it sounds. Sounds with similar numbers sound alike. To draw them on a page, the server finds each sound's closest neighbours and lays the dots out so that neighbours stay together, much like UMAP does. Distance between clusters means less than distance within one. Only sounds the server has already indexed appear, so the map grows as people search.
      </p>
    </section>
  </div>
</BaseLayout>
