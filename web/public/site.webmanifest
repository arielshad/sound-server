{
  "name": "Sound Server",
  "short_name": "Sounds",
  "description": "One search for free music samples: drums, 808s, loops, vocals and FX, with the licence on every sound.",
  "start_url": "/search",
  "display": "standalone",
  "background_color": "#16141f",
