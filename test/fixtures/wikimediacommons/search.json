g?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:909_house_pattern.ogg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=123116858","extmetadata":{"DateTime":{"value":"2022-09-18 14:33:55","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"909 house pattern","source":"mediawiki-metadata"},"Categories":{"value":"Roland TR-909|Self-published work|Drum sounds|Sounds of drum machines","source":"commons-categories","hidden":""},"ImageDescription":{"value":"A house pattern on the Roland TR-909 drum machine. There is a four-on-the-floor bass drum pattern, the clap sounds on every backbeat and the fourth off-beat on each bar, and the open hi-hat sounds on every off-beat. A cymbal sound is also heard at the beginning, and rimshot sounds at the end.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/w/index.php?title=User:ChristianTheHedgehog&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"User:ChristianTheHedgehog (page does not exist)\">Christian Carville</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"application/ogg","mediatype":"AUDIO"}],"videoinfo":[{"derivatives":[{"src":"https://upload.wikimedia.org/wikipedia/commons/4/4f/909_house_pattern.ogg?utm_source=commons.wikimedia.org&utm_campaign=api&utm_content=original","type":"audio/ogg; codecs=\"vorbis\"","width":0,"height":0,"bandwidth":326666},{"src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/4/4f/909_house_pattern.ogg/909_house_pattern.ogg.mp3","type":"audio/mpeg","transcodekey":"mp3","width":0,"height":0,"bandwidth":154144}]}]},{"pageid":190615115,"ns":6,"title":"File:Gated reverb with Strymon plate and noise gate (drums dry, drums + verb no gate, drums + gated verb).ogg","index":3,"imagerepository":"local","imageinfo":[{"size":149153,"width":0,"height":0,"duration":8.4,"url":"https://upload.wikimedia.org/wikipedia/commons/8/85/Gated_reverb_with_Strymon_plate_and_noise_gate_%28drums_dry%2C_drums_%2B_verb_no_gate%2C_drums_%2B_gated_verb%29.ogg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Gated_reverb_with_Strymon_plate_and_noise_gate_(drums_dry,_drums_%2B_verb_no_gate,_drums_%2B_gated_verb).ogg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=190615115","extmetadata":{"DateTime":{"value":"2026-04-28 11:51:57","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Gated reverb with Strymon plate and noise gate (drums dry, drums + verb no gate, drums + gated verb)","source":"mediawiki-metadata"},"Categories":{"value":"Self-published work|Audio files of drum music|Audio files of reverberation|Gated reverb|Audio files of music by Skimel","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Audio example of gated reverb on a snare.\n<ul><li>Drums: Addictive Drums 2</li>\n<li>Reverb: Strymon Big Sky plugin</li>\n<li>Noise gate: Reaper ReaGate plugin</li></ul>\n<p>First the dry sound of the drums (kick and snare) is played, then the same with a huge reverb on the snare, and finally the same sound but with a noise gate cutting sharply the reverb tail.\n</p>\nThe dry snare drum track is send to the sidechain input of the noise gate to control its opening.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Skimel\" title=\"User:Skimel\">Skimel</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"application/ogg","mediatype":"AUDIO"}],"videoinfo":[{"derivatives":[{"src":"https://upload.wikimedia.org/wikipedia/commons/8/85/Gated_reverb_with_Strymon_plate_and_noise_gate_%28drums_dry%2C_drums_%2B_verb_no_gate%2C_drums_%2B_gated_verb%29.ogg?utm_source=commons.wikimedia.org&utm_campaign=api&utm_content=original","type":"audio/ogg; codecs=\"vorbis\"","width":0,"height":0,"bandwidth":142050},{"src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/8/85/Gated_reverb_with_Strymon_plate_and_noise_gate_%28drums_dry%2C_drums_%2B_verb_no_gate%2C_drums_%2B_gated_verb%29.ogg/Gated_reverb_with_Strymon_plate_and_noise_gate_%28drums_dry%2C_drums_%2B_verb_no_gate%2C_drums_%2B_gated_verb%29.ogg.mp3","type":"audio/mpeg","transcodekey":"mp3","width":0,"height":0,"bandwidth":182152}]}]},{"pageid":190713826,"ns":6,"title":"File:Drums opening and closing a noise gate on a synth pad.wav","index":6,"imagerepository":"local","imageinfo":[{"size":6254514,"width":0,"height":0,"duration":21.714666666666666,"url":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=190713826","extmetadata":{"DateTime":{"value":"2026-04-29 15:16:42","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Drums opening and closing a noise gate on a synth pad","source":"mediawiki-metadata"},"Categories":{"value":"Noise gates|Self-published work|Audio files of drum music|Audio files of music by Skimel","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Exemple audio d'un noise gate appliqué sur un pad de synthé et dont l'ouverture est déclenchée par une batterie.\n<p>On entend d'abord le pad de synthé seul, puis la batterie seule, et ensuite les deux instruments ensemble. Ensuite, le noise gate est activé, produisant un son haché. Enfin, on entend le synthé seul avec le noise gate, pour bien entendre l'effet.\n</p><p>Réalisé dans Reaper avec les VST suivants : \n</p>\n<ul><li>Synthé : Surge (MKS 70 Warm Pad) - accord de Do majeur joué en midi</li>\n<li>Batterie : addictive Drums 2, kit \"Retroplex Eighties Box\", pattern \"909 techno\"</li>\n<li>Noise gate : ReaGate\n<ul><li>attack : 50 ms</li>\n<li>Hold : 10 ms</li>\n<li>Release : 100 ms</li></ul></li></ul>\nLa grosse caisse et le charley de la batterie (kick et hi-hat) sont envoyés dans l'entrée auxiliaire du gate (sidechain), et déclenchent son ouverture. Ainsi, le son du synthé n'est joué que lorske le kick ou le hit hat sont joués.","source":"commons-desc-page"},"Artist":{"value":"<a href=\"//commons.wikimedia.org/wiki/User:Skimel\" title=\"User:Skimel\">Skimel</a>","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by-sa/4.0","source":"commons-desc-page"}},"mime":"audio/wav","mediatype":"AUDIO"}],"videoinfo":[{"derivatives":[{"src":"https://upload.wikimedia.org/wikipedia/commons/5/5d/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav?utm_source=commons.wikimedia.org&utm_campaign=api&utm_content=original","type":"audio/wav","width":0,"height":0,"bandwidth":2304000},{"src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5d/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav.mp3","type":"audio/mpeg","transcodekey":"mp3","width":0,"height":0,"bandwidth":170400},{"src":"https://upload.wikimedia.org/wikipedia/commons/transcoded/5/5d/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav/Drums_opening_and_closing_a_noise_gate_on_a_synth_pad.wav.ogg","type":"audio/ogg; codecs=\"vorbis\"","transcodekey":"ogg","width":0,"height":0,"bandwidth":89720}]}]}]}}