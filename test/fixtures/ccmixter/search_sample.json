le_num_download" : 0, "download_url" : "https://ccmixter.org/content/AlexBeroza/AlexBeroza_-_Art_Now.flac", "local_path" : "/var/www/ccmixter/content/AlexBeroza/AlexBeroza_-_Art_Now.flac", "file_rawsize" : 29054872}], "upload_description_plain" : "Another exercise in making a techno track :)\r\n and again I'm not reaaly happy with some vox and sound placements, and the sound in general. Was busy for too long I think.\r\nHope it works for you guys...\r\n\r\nGreat vox by Snowflake!\r\n\r\n\r\nStems - ASAP\r\n\r\n*** Stems are up ***", "upload_description_html" : "Another exercise in making a techno track :)<br />\r\n and again I&#8217;m not reaaly happy with some vox and sound placements, and the sound in general. Was busy for too long I think.<br />\r\nHope it works for you guys&#8230;<br />\r\n<br />\r\nGreat vox by Snowflake!<br />\r\n<br />\r\n<br />\r\nStems - ASAP<br />\r\n<br />\r\n*** Stems are up ***"},{"upload_id" : 33345, "upload_name" : "Urbana-Metronica (wooh-yeah mix)", "upload_extra" : {"usertags" : "funk,instrumental,spinningmerkaba", "ccud" : "tubed_by_you,media,remix,editorial_pick,trackback,in_video,in_album,in_podcast,in_remix,bpm_100_105,ccplus", "systags" : "editorial_pick,attribution,audio,mp3,44k,stereo,CBR,archive,zip", "featuring" : "Morusque, Jeris, CSoul, Alex Beroza", "nsfw" : false, "bpm" : 100, "relative_dir" : "content/jlbrock44", "num_reviews" : 11, "edpicks" : {"admiralbob77" : {"reviewer" : "Admiral Bob", "review" : "There's no such thing as too much funk; spinningmerkaba has taken some of the funkiest pieces CCMixter had laying about, and with bursts of trumpet and clean tube-toned comping guitar, he's proven it once and for all!", "edited" : "2011-09-05 08:16:14"}}, "last_op" : "add", "ccplus" : true}, "user_name" : "jlbrock44", "upload_tags" : ",tubed_by_you,media,remix,editorial_pick,trackback,in_video,in_album,in_podcast,in_remix,bpm_100_105,ccplus,sample,attribution,audio,mp3,44k,stereo,CBR,archive,zip,funk,instrumental,spinningmerkaba,", "upload_num_scores" : 74, "file_page_url" : "https://ccmixter.org/files/jlbrock44/33345", "user_real_name" : "spinningmerkaba", "artist_page_url" : "https://ccmixter.org/people/jlbrock44", "license_logo_url" : "https://ccmixter.org/ccskins/shared/images/lics/small-by-3.png", "license_url" : "http://creativecommons.org/licenses/by/3.0/", "license_name" : "Attribution (3.0)", "upload_date_format" : "Sun, Sep 4, 2011 @ 10:37 PM", "qrank" : 368, "files" : [{"file_id" : 43375, "file_upload" : 33345, "file_name" : "jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "44k", "ch" : "stereo", "ps" : "3:27", "br" : "CBR"}, "file_extra" : {"sha1" : "LULIIIX6H44IE733LBEO4FCMZNTUVM76"}, "file_filesize" : " (3.17MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/jlbrock44/jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).mp3", "local_path" : "/var/www/ccmixter/content/jlbrock44/jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).mp3", "file_rawsize" : 3321147}, {"file_id" : 43389, "file_upload" : 33345, "file_name" : "jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).zip", "file_nicname" : "Tubed By You: Samples", "file_format_info" : {"media-type" : "archive", "format-name" : "archive-zip-", "default-ext" : "zip", "mime_type" : "application/zip", "zipdir" : {"files" : ["/urbanametronica_bass_320.mp3  (7.63MB)", "/urbanametronica_drums_320.mp3  (7.76MB)", "/urbanametronica_funk_guitar_320.mp3  (8.91MB)", "/urbanametronica_samples_320.mp3  (7.92MB)", "/urbanametronica_trumpets_320.mp3  (7.77MB)"]}}, "file_extra" : {"ccud" : "tubed_by_you,media,sample", "type" : "tubedbyyousamples", "sha1" : "KGGLHKG5XY25JPDLXGI2Q6YPMIUHT65H"}, "file_filesize" : " (30.78MB)", "file_order" : 1, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/jlbrock44/jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).zip", "local_path" : "/var/www/ccmixter/content/jlbrock44/jlbrock44_-_Urbana-Metronica_(wooh-yeah_mix).zip", "file_rawsize" : 32278947}], "upload_description_plain" : "You already have permission to use this track, but if you still need a license you can get one here\r\n\r\nRemix Notes:\r\nA remixtifunkation of stems generated from the triad of heavy duty productions known as Clavinometron, Organometronic,and Metronomix. Transformed now into Urbana-Metronica, its where the aliens like to go.   \r\n\r\nIn the mix:\r\n\r\nJeris-the clavs, \r\nCsoul-stank guitars and the phased out-reversed banjo\r\nAlex- (Wooh-Yeah!) on the panned-whah whah electric axe.\r\nMorusque-his organ sample started it all, and rocks the bridge in this version\r\nYours Truly bass trumpet drums guitar.\r\n\r\nNow--Get out and move around yo!\r\n\r\nNote:  Sample pak included", "upload_description_html" : "<span class=\"big\"><span class=\"green\">You already have permission to use this track, but if you still need a license you can get one  <a title=\"http://tunetrack.net/license/1/ccmixter.org/files/jlbrock44/33345\" class=\"cc_format_link\" href=\"http://tunetrack.net/license/1/ccmixter.org/files/jlbrock44/33345\">here</a></span></span><br />\r\n<br />\r\n<span class=\"u\">Remix Notes:</span><br />\r\nA remixtifunkation of stems generated from the triad of heavy duty productions known as Clavinometron, Organometronic,and Metronomix. Transformed now into Urbana-Metronica, its where the aliens like to go.   <br />\r\n<br />\r\nIn the mix:<br />\r\n<br />\r\n<span class=\"b\">Jeris</span>-the clavs, <br />\r\n<span class=\"b\">Csoul</span>-stank guitars and the phased out-reversed banjo<br />\r\n<span class=\"b\">Alex</span>- (Wooh-Yeah!) on the panned-whah whah electric axe.<br />\r\n<span class=\"b\">Morusque</span>-his organ sample started it all, and rocks the bridge in this version<br />\r\n<span class=\"b\">Yours Truly</span> bass trumpet drums guitar.<br />\r\n<br />\r\nNow&#8212;Get out and move around yo!<br />\r\n<br />\r\nNote:  Sample pak included"},{"upload_id" : 31670, "upload_name" : "Start Again", "upload_extra" : {"usertags" : "bass,downtempo,drums,female_vocals,guitar,synthesizer", "ccud" : "strike_the_root,corruption,media,remix,editorial_pick,trackback,in_video,in_podcast,bpm_080_085,ccplus", "systags" : "editorial_pick,attribution,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,flac,44k,stereo,VBR", "featuring" : "Snowflake & Subliminal", "nsfw" : false, "bpm" : 80, "relative_dir" : "content/AlexBeroza", "last_op" : "add", "num_reviews" : 13, "edpicks" : {"mykleanthony" : {"reviewer" : "mykleanthony", "review" : "If I was in a 3rd down and 10 situation, Alex would be who I'd send in. Consistently good and this track is class, it's top drawer, it's quality and it's Alex!!!! Great job!! [up][/up][up][/up]\r\n\r\nPeace! ;)~", "edited" : "2011-05-02 14:58:49"}}, "ccplus" : true}, "user_name" : "AlexBeroza", "upload_tags" : ",strike_the_root,corruption,media,remix,editorial_pick,trackback,in_video,in_podcast,bpm_080_085,ccplus,sample,multiple_formats,attribution,audio,mp3,44k,stereo,CBR,flac,VBR,bass,downtempo,drums,female_vocals,guitar,synthesizer,", "upload_num_scores" : 60, "file_page_url" : "https://ccmixter.org/files/AlexBeroza/31670", "user_real_name" : "Alex", "artist_page_url" : "https://ccmixter.org/people/AlexBeroza", "license_logo_url" : "https://ccmixter.org/ccskins/shared/images/lics/small-by-3.png", "license_url" : "http://creativecommons.org/licenses/by/3.0/", "license_name" : "Attribution (3.0)", "upload_date_format" : "Sun, May 1, 2011 @ 11:40 AM", "qrank" : 288, "files" : [{"file_id" : 40220, "file_upload" : 31670, "file_name" : "AlexBeroza_-_Start_Again.mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "44k", "ch" : "stereo", "ps" : "4:08"