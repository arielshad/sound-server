tml" : "Pell by Snowflake!<br />\r\nGuitar and synth by Subliminal!<br />\r\n<br />\r\nSimple and little loose&#8230; :)"},{"upload_id" : 31607, "upload_name" : "We Are Free", "upload_extra" : {"usertags" : "distortion,drums,female_vocals,groove,progressive,rock", "ccud" : "media,remix,corruption,strike_the_root,editorial_pick,bpm_120_125,trackback,in_video,in_podcast", "systags" : "editorial_pick,share_alike,audio,mp3,44k,stereo,archive,zip", "featuring" : "Snowflake", "nsfw" : false, "bpm" : 120, "relative_dir" : "content/zep_hurme", "num_reviews" : 7, "edpicks" : {"SackJo22" : {"reviewer" : "SackJo22", "review" : "Throughout history, rollicking drums have been used to communicate a change should be a'coming.  This simple, yet completely groovy track by Zep Hurme reinterprets the battle cry, in which the relationship of Zep's heavy drums with Snowflake's impassioned lyrics and pointed delivery is a great example of a balance of power.", "edited" : "2011-04-27 10:37:15"}}, "last_op" : "replace", "ccplus" : true}, "user_name" : "zep_hurme", "upload_tags" : ",media,remix,corruption,strike_the_root,editorial_pick,bpm_120_125,trackback,in_video,in_podcast,sample,share_alike,audio,mp3,44k,stereo,archive,zip,distortion,drums,female_vocals,groove,progressive,rock,", "upload_num_scores" : 55, "file_page_url" : "https://ccmixter.org/files/zep_hurme/31607", "user_real_name" : "Zep Hurme", "artist_page_url" : "https://ccmixter.org/people/zep_hurme", "license_logo_url" : "http://", "license_url" : "http://creativecommons.org/licenses/by-sa/3.0/", "license_name" : "Attribution Share-Alike  (3.0)", "upload_date_format" : "Wed, Apr 27, 2011 @ 7:38 AM", "qrank" : 274, "files" : [{"file_id" : 40110, "file_upload" : 31607, "file_name" : "zep_hurme_-_We_Are_Free.mp3", "file_nicname" : "mp3", "file_format_info" : {"media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg", "sr" : "44k", "ch" : "stereo", "ps" : "3:14"}, "file_extra" : {"sha1" : "CIB6CAUP3GNKBGFQLCGIC3SSZJI4ZQHN", "ccud" : "", "type" : ""}, "file_filesize" : " (3.96MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/zep_hurme/zep_hurme_-_We_Are_Free.mp3", "local_path" : "/var/www/ccmixter/content/zep_hurme/zep_hurme_-_We_Are_Free.mp3", "file_rawsize" : 4153202}, {"file_id" : 40130, "file_upload" : 31607, "file_name" : "zep_hurme_-_We_Are_Free.zip", "file_nicname" : "Stems", "file_format_info" : {"media-type" : "archive", "format-name" : "archive-zip-", "default-ext" : "zip", "mime_type" : "application/zip", "zipdir" : {"files" : ["/Channel - 01 - Lead voc (Snowflake).mp3  (2.40MB)", "/Channel - 02 - Back voc (Snowflake).mp3  (3.46MB)", "/Channel - 03 - Percussions (Zep Hurme).mp3  (1.93MB)", "/Channel - 05 - Drumkit (Zep Hurme).mp3  (4.29MB)", "/Channel - 06 - Distorted Synth (Zep Hurme).mp3  (2.75MB)", "/Channel - 07 - Strings (Zep Hurme).mp3  (1.29MB)", "/Channel - Send FX1 - Amp simulation (Zep Hurme).mp3  (3.16MB)", "/Channel - Send FX2 - Delay (Zep Hurme).mp3  (3.88MB)"]}}, "file_extra" : {"ccud" : "sample,media", "type" : "samples", "sha1" : "R5JGOZME6LC425XKQGQJKDUZX4IG2IWF"}, "file_filesize" : " (21.08MB)", "file_order" : 1, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/zep_hurme/zep_hurme_-_We_Are_Free.zip", "local_path" : "/var/www/ccmixter/content/zep_hurme/zep_hurme_-_We_Are_Free.zip", "file_rawsize" : 22101505}], "upload_description_plain" : "Great vocals by Snowflake. I really like the way she keeps things simple and tries not to showcase her obvious talent in every note. That's a mark of a pro, IMHO. I tried to keep the arrangement somewhat simple and minimalistic to support the great vocals.\r\n---\r\nlol - I can't seem to get this one right. I've now uploaded it several times and then I later find out it sounds like crap and have to tweak it again. I can't trust my own ears anymore it seems ... :) (Ear-fatigue)\r\n---\r\nSamples are MP3 192kbps ABR (average bitrate).\r\nAll the vocal/instrument -tracks + two \"send effect\" tracks are included. \r\n\"Send FX1 - Amp simulation\" is needed to mix in if you want to get the distorted drumkit sound on channel #05.", "upload_description_html" : "Great vocals by Snowflake. I really like the way she keeps things simple and tries <span class=\"u\">not</span> to showcase her obvious talent in every note. That&#8217;s a mark of a pro, IMHO. I tried to keep the arrangement somewhat simple and minimalistic to support the great vocals.<br />\r\n&#8212;-<br />\r\nlol - I can&#8217;t seem to get this one right. I&#8217;ve now uploaded it several times and then I later find out it sounds like crap and have to tweak it again. I can&#8217;t trust my own ears anymore it seems &#8230; :) (Ear-fatigue)<br />\r\n&#8212;-<br />\r\nSamples are MP3 192kbps ABR (average bitrate).<br />\r\nAll the vocal/instrument -tracks + two &#8220;send effect&#8221; tracks are included. <br />\r\n&#8220;Send FX1 - Amp simulation&#8221; is needed to mix in if you want to get the distorted drumkit sound on channel #05."},{"upload_id" : 30239, "upload_name" : "Emerge In Love", "upload_extra" : {"usertags" : "bass,drums,loops,synthesizer,techno,trance", "ccud" : "media,emergence_artlab,remix,trackback,in_video,in_podcast,bpm_125_130,in_remix,ccplus_stem,ccplus", "systags" : "attribution,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR,audio,mp3,44k,stereo,CBR", "featuring" : "SackJo22 & Magic Moon", "nsfw" : false, "bpm" : 125, "relative_dir" : "content/AlexBeroza", "last_op" : "add", "num_reviews" : 12, "ccplus" : true}, "user_name" : "AlexBeroza", "upload_tags" : ",media,emergence_artlab,remix,trackback,in_video,in_podcast,bpm_125_130,i