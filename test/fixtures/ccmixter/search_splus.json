1" : "XSU3WXD524JUVHSNSGK7GK22WNUU73CH"}, "file_filesize" : " (9.41MB)", "file_order" : 10, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/snowflake/snowflake_-_Gloria_(angel_mix_w_DoKashiteru)_8.mp3", "local_path" : "/var/www/ccmixter/content/snowflake/snowflake_-_Gloria_(angel_mix_w_DoKashiteru)_8.mp3", "file_rawsize" : 9864384}], "upload_description_plain" : "I've added the 'song stems' (sort of like samples, but more like a source track?) for this track for your remix enjoyment. \r\n\r\nI had this foggy vision of creating an ambient/electronic mash-up of Silent Night & Angels We Have Heard on High, and without sounding religious. I listened to tracks on ccMixter for days...and when I heard Yiourgh by DoKashiteru, I held my breath! It was perfect. DoKashiteru's amazing track created the perfect framework for this piece (peace!)...and it just sort of wrote itself.\r\n\r\nDoubling DoKashiteru's genius piano part was challenging because I play all my tracks live - I am ignorant and afraid of midi and quantization :/\r\n\r\nThanks to all of you for the incredible remixes submitted so far - I am so emotional about it.  \r\n\r\nPeace.", "upload_description_html" : "I&#8217;ve added the &#8216;song stems&#8217; (sort of like samples, but more like a source track?) for this track for your remix enjoyment. <br />\r\n<br />\r\nI had this foggy vision of creating an ambient/electronic mash-up of Silent Night & Angels We Have Heard on High, and without sounding religious. I listened to tracks on ccMixter for days&#8230;and when I heard Yiourgh by DoKashiteru, I held my breath! It was perfect. DoKashiteru&#8217;s amazing track created the perfect framework for this piece (peace!)&#8230;and it just sort of wrote itself.<br />\r\n<br />\r\nDoubling DoKashiteru&#8217;s genius piano part was challenging because I play all my tracks live - I am ignorant and afraid of midi and quantization :/<br />\r\n<br />\r\nThanks to  <a title=\"http://ccmixter.org/playlist/browse/5681\" class=\"cc_format_link\" href=\"http://ccmixter.org/playlist/browse/5681\">all of you</a> for the incredible remixes submitted so far - I am so emotional about it.  <br />\r\n<br />\r\nPeace."},{"upload_id" : 596, "upload_name" : "The Same But Different acapella rap", "upload_extra" : {"ccud" : "media,acappella,bpm_095_100,featured,trackback,in_video", "usertags" : "ambient,atmospheric,chill,downtempo,loops,synthesizer,wav", "relative_dir" : "content/beatgorilla", "bpm" : 97, "systags" : "sampling_plus,audio,mp3,44k,stereo,320kbps", "num_reviews" : 5}, "user_name" : "beatgorilla", "upload_tags" : ",media,acappella,bpm_095_100,featured,trackback,in_video,sampling_plus,audio,mp3,44k,stereo,320kbps,ambient,atmospheric,chill,downtempo,loops,synthesizer,wav,", "upload_num_scores" : 27, "file_page_url" : "https://ccmixter.org/files/beatgorilla/596", "user_real_name" : "Pat Chilla The Beat Gorilla", "artist_page_url" : "https://ccmixter.org/people/beatgorilla", "license_logo_url" : "http://", "license_url" : "http://creativecommons.org/licenses/sampling+/1.0/", "license_name" : "Sampling Plus", "upload_date_format" : "Thu, Feb 24, 2005 @ 1:37 AM", "qrank" : 116, "files" : [{"file_id" : 424, "file_upload" : 596, "file_name" : "beatgorilla_-_The_Same_But_Different_acapella_rap.mp3", "file_nicname" : "mp3", "file_format_info" : {"sr" : "44k", "ch" : "stereo", "ps" : "0:42", "br" : "320kbps", "media-type" : "audio", "format-name" : "audio-mp3-mp3", "default-ext" : "mp3", "mime_type" : "audio/mpeg"}, "file_extra" : {"port_path" : "/web/ccmixter/www/people/beatgorilla/beatgorilla_-_The_Same_But_Different_acapella_rap.mp3"}, "file_filesize" : " (1.60MB)", "file_order" : 0, "file_is_remote" : 0, "file_num_download" : 0, "download_url" : "https://ccmixter.org/content/beatgorilla/beatgorilla_-_The_Same_But_Different_acapella_rap.mp3", "local_path" : "/var/www/ccmixter/content/beatgorilla/beatgorilla_-_The_Same_But_Different_acapella_rap.mp3",